# --- Analytics -------------------------------------------------------------
# Google Tag Manager container. Leave blank in dev: the dataLayer still
# initialises and every event is logged to the console so it stays verifiable.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Mock IDs used by the in-page GA4 / Meta Pixel event shims.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-DEMO12345
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# --- Lead capture ----------------------------------------------------------
# Dummy CRM sink. Any endpoint that accepts a JSON POST works:
#   * Google Sheet via SheetDB / Sheety / an Apps Script Web App URL
#   * https://webhook.site/#!/<your-uuid>  (easiest to verify)
LEAD_WEBHOOK_URL=

# Optional shared secret forwarded as `x-api-key` to the webhook above.
LEAD_WEBHOOK_TOKEN=
